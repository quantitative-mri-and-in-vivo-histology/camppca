# Machine-specific host paths for the optional bind mounts in
# docker-compose.override.yml. Copy to `.env` (gitignored) and edit per machine.
#
#   cp .env.example .env
#
# Consumed by Compose via ${VAR} substitution. An unset variable referenced by an
# active mount makes the container fail to start with an empty-path error — if
# you comment out a mount, comment out its variable too (or leave it set).

# Large working dataset, mounted read-write at /data.
# PROJECT_DATA_HOST=/media/you/Data/work/my-project

# Immutable source data, mounted read-only at /raw.
# RAW_DATA_HOST=/media/you/Data/raw

# Host toolchain mounted at the same absolute path inside the container.
# TOOLDIR=/home/you/opt/sometool

# Container timezone (defaults to Europe/Berlin if unset).
# TZ=Europe/Berlin
