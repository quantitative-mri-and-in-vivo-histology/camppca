// CPU only, no added capabilities: camppca runs on numpy and scipy.
{
  "name": "Dev Container",
  "dockerComposeFile": [
    "docker-compose.yml",
    "docker-compose.override.yml"
  ],
  "service": "devcontainer",
  "workspaceFolder": "/workspace",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "ms-toolsai.jupyter",
        "charliermarsh.ruff",
        "eamodio.gitlens",
        "hediet.debug-visualizer"
      ]
    }
  },
  "remoteUser": "node",
  "postCreateCommand": "/usr/local/bin/post-create.sh",
  "postStartCommand": "npm update -g @anthropic-ai/claude-code",
  "waitFor": "postStartCommand"
}
