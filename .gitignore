### VisualStudioCode
# Ignore the folder's contents, then re-include the files that are part of the
# project setup. NOTE: do not add a `**/.vscode` rule here — excluding the
# directory itself makes git ignore it wholesale and every `!` below becomes
# unreachable, which is why launch.json used to be uncommittable.
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json
*.code-workspace

# JetBrains
.idea/

# Poetry lock file
poetry.lock

