.claude/logs/
.claude/history/
.claude/*.local.*
.claude/secrets.*

# Environment variables (.env.example is committed as a template).
# The bare `.env` pattern has no slash, so it also covers .devcontainer/.env.
.env
.env.local
.env.*.local

# Devcontainer: machine-specific compose overlay (the .example is committed).
.devcontainer/docker-compose.override.yml


# LaTeX temporary files
*.aux
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
*.toc

# Output directories
.DS_Store
node_modules/
package-lock.json
package.json

# Local scratch: working notes and source material, not part of the package.
reference/

# Internal notes. docs/ may hold user-facing documentation; docs/local/ never
# leaves this machine.
**/docs/local/
