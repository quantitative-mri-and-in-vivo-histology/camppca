{
  // Editor/Python settings live here rather than in devcontainer.json so they
  // also apply when the folder is opened outside a container.
  "editor.formatOnSave": false,
  // Format-on-save is OFF deliberately. The engine under camppca/denoiser/ is a port
  // whose bodies are kept comparable line-by-line against reference/, and a save-time
  // reformat rewrites ~800 lines across 16 files -- churn that leaks into unrelated
  // commits. Format explicitly when you mean to: `ruff format camppca tests`.
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": false,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "never"
    }
  },
  "python.defaultInterpreterPath": "/usr/local/bin/python3",
  "python.languageServer": "Pylance",
  "python.terminal.executeInFileDir": false,
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"],
  "python.analysis.extraPaths": ["."],
  "jupyter.notebookFileRoot": "${workspaceFolder}",
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.egg-info": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/.mypy_cache": true
  },
  "terminal.integrated.defaultProfile.linux": "zsh",
  "terminal.integrated.profiles.linux": {
    "bash": { "path": "bash", "icon": "terminal-bash" },
    "zsh": { "path": "zsh" }
  }
}
